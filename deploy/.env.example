# 复制为 .env 并全部改成你自己的值

# 应用镜像地址，把 your-github-name 换成你的 GitHub 用户名（全小写）
LUMALOG_IMAGE=ghcr.io/your-github-name/lumalog:latest

# 博客域名（Caddy 会自动为它签发 HTTPS 证书）
SITE_DOMAIN=blog.example.com

# 后台登录账密（务必修改！）
NUXT_ADMIN_USERNAME=admin
NUXT_ADMIN_PASSWORD=change-me-to-a-strong-password

# 会话加密密钥，32 位以上随机字符串
# 生成命令：openssl rand -base64 32
NUXT_SESSION_PASSWORD=change-me-run-openssl-rand-base64-32
